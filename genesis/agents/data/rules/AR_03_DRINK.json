{
  "rule_id": "AR_03_DRINK",
  "name": "Agent Hydration Drinking from Soil Water",
  "version": "1.0.0",
  "author": "human_bootstrap",
  "priority": 80,
  "spatial_partitioned": true,
  "target_selector": {
    "entity_type": "agent",
    "limit": 4,
    "filter": {
      "op": "AND",
      "left": {
        "op": "AND",
        "left": {
          "op": "EQUALS",
          "left": {
            "op": "GET_PROPERTY",
            "entity": "target",
            "property": "is_alive"
          },
          "right": {
            "op": "LITERAL",
            "type": "INT64",
            "value": "1"
          }
        },
        "right": {
          "op": "EQUALS",
          "left": {
            "op": "GET_PROPERTY",
            "entity": "target",
            "property": "action_taken"
          },
          "right": {
            "op": "LITERAL",
            "type": "INT64",
            "value": "0"
          }
        }
      },
      "right": {
        "op": "GREATER_THAN_OR_EQUAL",
        "left": {
          "op": "GET_PROPERTY",
          "entity": "target",
          "property": "thirst"
        },
        "right": {
          "op": "LITERAL",
          "type": "FIXED_POINT",
          "value": "30.000000"
        }
      }
    }
  },
  "preconditions": [
    {
      "op": "GREATER_THAN_OR_EQUAL",
      "left": {
        "op": "GET_RESOURCE",
        "pool": "soil_water"
      },
      "right": {
        "op": "LITERAL",
        "type": "FIXED_POINT",
        "value": "2.000000"
      }
    }
  ],
  "effects": [
    {
      "op": "IF",
      "condition": {
        "op": "GREATER_THAN_OR_EQUAL",
        "left": {
          "op": "GET_PROPERTY",
          "entity": "target",
          "property": "thirst"
        },
        "right": {
          "op": "LITERAL",
          "type": "FIXED_POINT",
          "value": "30.000000"
        }
      },
      "then": [
        {
          "op": "CONSUME_RESOURCE",
          "pool": "soil_water",
          "amount": {
            "op": "LITERAL",
            "type": "FIXED_POINT",
            "value": "2.000000"
          }
        },
        {
          "op": "PRODUCE_RESOURCE",
          "pool": "soil_water",
          "amount": {
            "op": "LITERAL",
            "type": "FIXED_POINT",
            "value": "2.000000"
          }
        },
        {
          "op": "IF",
          "condition": {
            "op": "GREATER_THAN_OR_EQUAL",
            "left": {
              "op": "GET_PROPERTY",
              "entity": "target",
              "property": "thirst"
            },
            "right": {
              "op": "LITERAL",
              "type": "FIXED_POINT",
              "value": "50.000000"
            }
          },
          "then": [
            {
              "op": "ADJUST_PROPERTY",
              "entity": "target",
              "property": "thirst",
              "delta": {
                "op": "LITERAL",
                "type": "FIXED_POINT",
                "value": "-50.000000"
              }
            }
          ],
          "else": [
            {
              "op": "SET_PROPERTY",
              "entity": "target",
              "property": "thirst",
              "value": {
                "op": "LITERAL",
                "type": "FIXED_POINT",
                "value": "0.000000"
              }
            }
          ]
        },
        {
          "op": "SET_PROPERTY",
          "entity": "target",
          "property": "action_taken",
          "value": {
            "op": "LITERAL",
            "type": "INT64",
            "value": "1"
          }
        }
      ],
      "else": []
    }
  ]
}