{
  "rule_id": "AR_02_MORTALITY",
  "name": "Agent Starvation Dehydration and Senescence Mortality",
  "version": "1.0.0",
  "author": "human_bootstrap",
  "priority": 85,
  "spatial_partitioned": true,
  "target_selector": {
    "entity_type": "agent",
    "limit": 4,
    "filter": {
      "op": "EQUALS",
      "left": {
        "op": "GET_PROPERTY",
        "entity": "target",
        "property": "is_alive"
      },
      "right": {
        "op": "LITERAL",
        "type": "INT64",
        "value": "1"
      }
    }
  },
  "preconditions": [],
  "effects": [
    {
      "op": "IF",
      "condition": {
        "op": "OR",
        "left": {
          "op": "OR",
          "left": {
            "op": "LESS_THAN_OR_EQUAL",
            "left": {
              "op": "GET_PROPERTY",
              "entity": "target",
              "property": "energy"
            },
            "right": {
              "op": "LITERAL",
              "type": "FIXED_POINT",
              "value": "0.000000"
            }
          },
          "right": {
            "op": "GREATER_THAN_OR_EQUAL",
            "left": {
              "op": "GET_PROPERTY",
              "entity": "target",
              "property": "hunger"
            },
            "right": {
              "op": "LITERAL",
              "type": "FIXED_POINT",
              "value": "100.000000"
            }
          }
        },
        "right": {
          "op": "OR",
          "left": {
            "op": "GREATER_THAN_OR_EQUAL",
            "left": {
              "op": "GET_PROPERTY",
              "entity": "target",
              "property": "thirst"
            },
            "right": {
              "op": "LITERAL",
              "type": "FIXED_POINT",
              "value": "100.000000"
            }
          },
          "right": {
            "op": "GREATER_THAN_OR_EQUAL",
            "left": {
              "op": "GET_PROPERTY",
              "entity": "target",
              "property": "age_ticks"
            },
            "right": {
              "op": "GET_PROPERTY",
              "entity": "target",
              "property": "longevity"
            }
          }
        }
      },
      "then": [
        {
          "op": "PRODUCE_RESOURCE",
          "pool": "detritus",
          "amount": {
            "op": "GET_PROPERTY",
            "entity": "target",
            "property": "biomass"
          }
        },
        {
          "op": "DESTROY_ENTITY",
          "entity": "target"
        }
      ],
      "else": []
    }
  ]
}